# Copiar a .env y completar. .env nunca se commitea.
# Formato: postgres://USUARIO:CLAVE@HOST:PUERTO/BASE

# Rol de la aplicación (sin BYPASSRLS, no es dueño de las tablas). `pnpm db:migrate` lo crea si no existe.
DATABASE_URL=
# Rol con permisos de administración (por ejemplo, postgres) para crear la base, aplicar migraciones y cargar el seed.
DATABASE_URL_MIGRACIONES=

# Lo mismo, sobre la base de tests (se borra y recrea en cada corrida de `pnpm test:integration`).
DATABASE_URL_TEST=
DATABASE_URL_TEST_MIGRACIONES=